# NUNCA preencha valores reais aqui — este arquivo é versionado e carrega só os
# NOMES das chaves.
#
# ⚠️ ONDE COPIAR, que não é a raiz:
#
#   as variáveis de backend  ->  backend/.env.local
#
# `app/settings.py` procura em `backend/.env.local` (ver `ENV_FILE`) e **ignora
# qualquer .env na raiz do repositório**. O carregamento depende de
# `python-dotenv`, que está em `requirements-dev.txt` — em produção as variáveis
# vêm da plataforma e o carregamento é no-op.
#
# Todos os defaults equivalem ao comportamento de desenvolvimento: sem arquivo,
# o `docker compose up` e o `pytest` funcionam como sempre.

# --- backend -------------------------------------------------------------
# Local: SQLite (D-Vercel-1). Produção: Postgres no Neon, SEMPRE pelo endpoint
# com pooler (host com `-pooler`) — ver "Pool de conexão" no CLAUDE.md.
#
#   produção: postgresql+psycopg://user:senha@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#
# Pode colar a string do painel do Neon como ela vem: `postgresql://` e
# `postgres://` recebem o driver `+psycopg` automaticamente
# (`normalize_database_url`). Driver explícito, se você informar um, é
# respeitado.
#
# ⚠️ SQLite absoluto leva QUATRO barras. Com três, o SQLAlchemy interpreta como
# caminho RELATIVO e o banco nasce no diretório de trabalho do processo.
DATABASE_URL=sqlite:////workspace/backend/database.db

# Origens permitidas, separadas por vírgula.
# ⚠️ Em produção NÃO é necessária: o rewrite `/api` do frontend faz o browser
# enxergar uma origem só (D-Vercel-3). Existe para o desenvolvimento local, em
# que front (5173) e API (8000) estão em portas diferentes.
CORS_ALLOW_ORIGINS=*

# --- testes --------------------------------------------------------------
# Separada de DATABASE_URL de propósito: rodar a suíte não pode, por acidente de
# ambiente, apagar o banco de trabalho. Vazia = SQLite em memória.
# O job `backend-postgres` do CI aponta para o serviço real.
# TEST_DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5432/finance_test

# --- autenticação (backend) ----------------------------------------------
# Login é exclusivamente "Entrar com o Google" (D-Auth-1). Não há senha nem
# outro provedor.

# 🔴 OBRIGATÓRIA em produção, SEM default — segredo com default é segredo
# conhecido (D-Auth-5). Ausência é erro de inicialização, não aviso.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Localmente (SQLite) há um default explicitamente inseguro, e ele NÃO deve ser
# copiado para a Vercel.
SESSION_SECRET=

# ⚠️ Vazia = NINGUÉM entra (fail closed, D-Auth-2). Allowlist ausente não pode
# significar allowlist aberta.
# Lista por vírgula; a comparação é case-insensitive.
AUTH_ALLOWED_EMAILS=

# Público, não é segredo. Mesmo valor de VITE_GOOGLE_CLIENT_ID abaixo —
# duplicado porque backend e frontend são dois projetos na Vercel.
GOOGLE_CLIENT_ID=

# --- frontend ------------------------------------------------------------
# Em produção é `/api`, relativa — o rewrite do vercel.json cuida do resto, e
# caminho relativo não tem domínio para envelhecer no bundle.
VITE_API_BASE_URL=http://localhost:8000/api

# ⚠️ Resolvida em BUILD: o valor é inlinado no bundle. Trocar na Vercel exige
# **rebuild**, não restart. Mesmo valor de GOOGLE_CLIENT_ID acima.
VITE_GOOGLE_CLIENT_ID=
