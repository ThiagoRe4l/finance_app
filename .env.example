# Copie para .env e ajuste. NUNCA versione o .env (já está no .gitignore) nem
# preencha valores reais aqui — este arquivo carrega só os NOMES das chaves.
#
# Todas as variáveis têm default igual ao comportamento de hoje: sem .env, o
# `docker compose up` e o `pytest` funcionam exatamente como antes.

# --- backend -------------------------------------------------------------
# ⚠️ SQLite absoluto leva QUATRO barras. Com três, o SQLAlchemy interpreta como
# caminho RELATIVO, o banco nasce fora do volume e o dado some no redeploy.
# Railway: sqlite:////data/database.db (com o volume montado em /data)
DATABASE_URL=sqlite:////workspace/backend/database.db

# Origens permitidas, separadas por vírgula. `*` só em desenvolvimento.
# Railway: https://<frontend>.up.railway.app
CORS_ALLOW_ORIGINS=*

# --- frontend ------------------------------------------------------------
# ⚠️ Resolvida em BUILD, não em runtime: o valor é inlinado no bundle. Trocar
# aqui e reiniciar o serviço NÃO tem efeito — é preciso rebuildar.
# Railway: https://${{backend.RAILWAY_PUBLIC_DOMAIN}}/api
VITE_API_BASE_URL=http://localhost:8000/api
